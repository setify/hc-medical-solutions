# ─── Datenbank (lokal: `pnpm db:start`, Werte aus `supabase status`) ───
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres

# ─── Payload ───
# Zufallswert, z. B. `openssl rand -hex 32`
PAYLOAD_SECRET=
# Öffentliche Basis-URL der Website (ohne Slash am Ende)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Datei-Storage (Supabase Storage via S3-Protokoll) ───
# Leer lassen = Uploads landen lokal im Dateisystem (nur für Entwicklung/CI).
S3_ENDPOINT=http://127.0.0.1:55421/storage/v1/s3
S3_REGION=local
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Indexierung & Staging-Schutz ───
# Nur in Produktion auf "true" setzen. Sonst: robots Disallow + X-Robots-Tag noindex.
SITE_INDEXABLE=false
# Wenn beide gesetzt: HTTP-Basic-Auth vor der gesamten Website (Staging).
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=
